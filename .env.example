# ===== DeepSeek 大模型 =====
# 在 platform.deepseek.com 右上角「API Keys」创建，形如 sk-xxxx
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== 基础设施（docker compose up -d 一键启动）=====
# 向量库后端：pgvector（生产） / chroma（零依赖本地）
VECTOR_BACKEND=pgvector
POSTGRES_DSN=postgresql://ragkb:ragkb123@127.0.0.1:5432/rag_kb
REDIS_URL=redis://127.0.0.1:6379/0

# ===== 性能调参（v0.5，压测结论见 docs/DESIGN.md 第 12 节）=====
# 单条 ONNX 推理线程数（默认全核会让并发请求互相抢核）
ONNX_THREADS=4
# 线程池按用途拆成三个（工单 14），避免互相排队：
# 推理/检索计算（BGE/重排/BM25）
RAG_CPU_WORKERS=3
# 注册中心与元数据读写（不占 CPU，也不该排在推理任务后面）
RAG_META_WORKERS=4
# 文档摄取（解析/切片/批量 embed）；彻底移出进程见工单 12
RAG_INGEST_WORKERS=2

# ===== 向量索引（工单 09，默认关闭）=====
# ANN 索引类型：none（默认，精确顺序扫描） / hnsw / ivfflat
# 默认 none 是实测结论：50k 行下带 kb_id 过滤的顺序扫描约 16ms 且完全精确；
# HNSW 在带过滤且规划器真的走索引时，ef_search=1000 的召回也只有 0.739。
# 注意规划器会随 ef_search 切换计划，复测时必须同时记录执行计划。
# 数据见 data/bench/ann_report.json，开启前请复跑 scripts/bench_ann.py。
ANN_INDEX=none
# HNSW 查询期候选队列长度（pgvector 合法区间 1..1000）
HNSW_EF_SEARCH=100

# ===== 边界防护与流式（工单 19/20）=====
# 单次上传体积上限（MB），0 = 不限制
MAX_UPLOAD_MB=20
# 令牌桶速率（每秒请求数），0 = 关闭限流（默认，不改变既有部署行为）
RATE_LIMIT_RPS=0
RATE_LIMIT_BURST=20
# SSE 空闲心跳间隔（秒）：LLM 首 token 可能等十几秒，代理默认空闲超时会掐断流
SSE_HEARTBEAT_SECONDS=15

# 摄取模式：sync（默认，请求内同步索引，返回 201） / queue（交给 arq worker，返回 202）
# queue 是破坏性变更（chunk_count 不再立即可得），所以默认保持 sync；
# 生产用 docker compose 时把 api 与 worker 两侧都设成 queue
INGEST_MODE=sync

# ===== 多知识库与访问控制（v0.6）=====
# 默认知识库名（启动时自动创建；脚本入库与单库问答的落点）
DEFAULT_KB=default
# 合法 X-API-Key（逗号分隔）；留空 = 关闭鉴权
API_KEYS=
