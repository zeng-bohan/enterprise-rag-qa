# ===== DeepSeek 大模型 =====
# 在 platform.deepseek.com 右上角「API Keys」创建，形如 sk-xxxx
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== 基础设施（docker compose up -d 一键启动）=====
# 向量库后端：pgvector（生产） / chroma（零依赖本地）
VECTOR_BACKEND=pgvector
POSTGRES_DSN=postgresql://ragkb:ragkb123@127.0.0.1:5432/rag_kb
REDIS_URL=redis://127.0.0.1:6379/0

# ===== 性能调参（v0.5，压测结论见 docs/DESIGN.md 第 12 节）=====
# 单条 ONNX 推理线程数（默认全核会让并发请求互相抢核）
ONNX_THREADS=4
# CPU 密集任务专用线程池大小（BGE/重排/BM25，超出排队）
RAG_CPU_WORKERS=3

# ===== 多知识库与访问控制（v0.6）=====
# 默认知识库名（启动时自动创建；脚本入库与单库问答的落点）
DEFAULT_KB=default
# 合法 X-API-Key（逗号分隔）；留空 = 关闭鉴权
API_KEYS=
